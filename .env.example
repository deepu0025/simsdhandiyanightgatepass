# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production-only HTTPS settings (enable only behind a trusted HTTPS proxy)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
# DJANGO_TRUST_X_FORWARDED_PROTO=true
APP_TIME_ZONE=Asia/Kolkata
FRONTEND_URL=http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# PostgreSQL (leave DATABASE_URL empty to use local SQLite for development)
DATABASE_URL=

# Persistent ticket PDF storage path. Use a persistent volume or private object storage in production.
MEDIA_ROOT=backend/private_media

# Gmail API OAuth 2.0 (no SMTP password or app password)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Event Operations

# Google Sheets (optional; never store service-account JSON in this file)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Alternatively, inject the complete service-account JSON via your secret manager
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Frontend API proxy
VITE_API_URL=http://127.0.0.1:8001
